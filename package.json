{
  "name": "cloud-cost-investigator",
  "version": "0.1.0",
  "description": "Read-only, evidence-driven EC2 off-hours scheduling investigation CLI.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "npx --yes degit meterless/meterless/engines/hmem/reference vendor/hmem && cd vendor/hmem && npm install --no-audit --no-fund",
    "notebook": "tsx notebook.ts",
    "investigate": "node --import tsx cli.ts investigate",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:scenarios": "node --import tsx --test --test-isolation=none tests/investigation.test.ts tests/broader-scenarios.test.ts tests/warm.test.ts",
    "demo:scenarios": "node --import tsx --test --test-isolation=none --test-reporter=spec --test-name-pattern=^EC2 tests/investigation.test.ts tests/broader-scenarios.test.ts tests/warm.test.ts",
    "export:scenarios": "node --import tsx scripts/export-scenarios.ts",
    "typecheck": "tsc -p tsconfig.investigation.json --noEmit",
    "probe:hmem": "node --import tsx scripts/probe-hmem.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "probe:zetaris": "node --import tsx scripts/probe-zetaris.ts",
    "test:integration": "node --import tsx --test --test-isolation=none tests/integration/*.test.ts",
    "probe:zetaris:history": "node --import tsx scripts/probe-zetaris.ts --history",
    "probe:zetaris:roundtrip": "node --import tsx scripts/probe-zetaris-history-roundtrip.ts",
    "test:aws": "node --import tsx --test --test-isolation=none tests/aws*.test.ts",
    "typecheck:aws": "tsc -p tsconfig.aws.json",
    "demo:aws": "tsx src/aws-demo.ts",
    "probe:warm": "node --import tsx scripts/probe-warm.ts",
    "demo:warm": "node --import tsx scripts/demo-warm.ts",
    "followup": "node --import tsx scripts/follow-up.ts",
    "demo:followup": "node --import tsx scripts/demo-follow-up.ts",
    "evaluate:memory": "node --import tsx scripts/evaluate-memory.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "demo:web": "node --import tsx scripts/demo-web.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1156.0",
    "@aws-sdk/client-cost-explorer": "^3.1156.0",
    "@aws-sdk/client-ec2": "^3.1156.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0"
  }
}
