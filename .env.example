# Copy to .env; never commit credentials. Shell variables override this file.
# Generic OpenAI-compatible Chat Completions endpoint: base includes /v1,
# and the client appends /chat/completions. Select --planner model.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
# text works without provider-specific structured-output support.
# Other values: json_object, json_schema (only when your provider supports them).
LLM_RESPONSE_FORMAT=json_schema
# Optional provider request parameters, JSON only. No model/messages/tool overrides.
# Output tokens default to 1024; max_tokens OR max_completion_tokens may be 1..4096.
LLM_EXTRA_BODY='{"temperature":1,"top_p":0.95,"chat_template_kwargs":{"enable_thinking":false}}'

# Examples for other providers: replace the LLM_* values above, not both at once.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id
# LLM_RESPONSE_FORMAT=text
# LLM_EXTRA_BODY='{"max_completion_tokens":1024}'
# Local unauthenticated server: http://127.0.0.1:11434/v1; leave LLM_API_KEY empty.
# Remove NVIDIA-only chat_template_kwargs when switching providers.

# Backward compatibility when all LLM_* settings are absent:
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris: use the Web UI origin, because the client uses its /api/auth/login
# and /api/proxy/sql-editor/sqls/run-query routes. This is NOT a disk path,
# JDBC URL, or the internal API port 8889. Example for the supplied Compose:
ZETARIS_BASE_URL=http://127.0.0.1:3000
# Explicit opt-in for this authorized local HTTP deployment. Prefer HTTPS otherwise.
ZETARIS_ALLOW_HTTP=true

# Login as the dedicated app user; never use the administrator for normal app access.
ZETARIS_AUTH_MODE=password
ZETARIS_USERNAME=
# Quote passwords containing #, spaces or other .env syntax. Never commit this value.
ZETARIS_PASSWORD=''
# Optional in password mode: discovered from login. If set, must match the login org.
ZETARIS_ORG_ID=
# Alternative: AUTH_MODE=token, API_KEY=<bearer idToken>, ORG_ID=<matching org>.
# Token mode does not use username/password; password mode never falls back to this key.
ZETARIS_API_KEY=

# Registered SQL table, NOT /home/zetaris/customer-data/shared/cci-history.
# First create the table using scripts/zetaris-history.sql in Zetaris as an admin,
# then verify the app user's table-scoped read/append permissions.
ZETARIS_HISTORY_TABLE=CCI_HISTORY.investigations.records
# Enable only after provisioning/permissions. Normal probes never enable writes.
ZETARIS_HISTORY_ALLOW_APPEND=false
# Manual read/append/read-back proof (retains one synthetic record):
# npm run probe:zetaris:roundtrip
